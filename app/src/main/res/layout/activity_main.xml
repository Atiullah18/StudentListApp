<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFFFFF"
    android:padding="38dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="25dp" />

    <!-- Student Image -->
    <ImageView
        android:id="@+id/studentRegistrationImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/student_registration"
        android:scaleType="centerCrop"
        android:contentDescription="Student Registration Image"
        android:layout_marginBottom="15dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Registration Form"
        android:textColor="#4055B8"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <!-- Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="#333333"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter Name"
            android:textSize="18sp"
            android:singleLine="true"
            android:backgroundTint="#BDBDBD" />

    </LinearLayout>

    <!-- Roll No -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:text="Roll No"
            android:textColor="#333333"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etRoll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter Roll No"
            android:textSize="18sp"
            android:singleLine="true"
            android:backgroundTint="#BDBDBD" />

    </LinearLayout>

    <!-- Course -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="105dp"
            android:layout_height="wrap_content"
            android:text="Course"
            android:textColor="#333333"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etCourse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter Course"
            android:textSize="18sp"
            android:singleLine="true"
            android:backgroundTint="#BDBDBD" />

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="105dp"
            android:layout_height="60dp"
            android:text="SAVE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4055B8" />

        <Button
            android:id="@+id/btnView"
            android:layout_width="125dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="VIEW ALL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4055B8" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="105dp"
            android:layout_height="60dp"
            android:text="CLEAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4055B8" />

    </LinearLayout>

</LinearLayout>